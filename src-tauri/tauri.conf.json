{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unity Slot Widget",
  "version": "0.3.0",
  "identifier": "io.github.cykim0115.unity-slot-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Unity Slot Widget",
        "width": 1200,
        "height": 760,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "../LICENSE",
    "shortDescription": "Desktop app for unity-slot slots",
    "longDescription": "A desktop app that shows the slots registered with unity-slot: which Unity editors are open, starting or closed, who holds a lease, how much memory each editor tree uses, and local-only git state. The tray tooltip and the taskbar icon show the worst state while the window is out of sight.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
