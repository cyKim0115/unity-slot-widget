{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unity Slot Widget",
  "version": "0.1.0",
  "identifier": "io.github.cykim0115.unity-slot-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Unity Slot Widget",
        "width": 400,
        "height": 320,
        "minWidth": 320,
        "minHeight": 140,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Unity Slot Widget",
        "url": "settings.html",
        "width": 500,
        "height": 660,
        "minWidth": 420,
        "maxWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://glassbg.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "license": "../LICENSE",
    "shortDescription": "Live view of unity-slot slots",
    "longDescription": "A small always-visible desktop widget that shows the slots registered with unity-slot: which Unity editors are open, starting or closed, who holds a lease, how much memory each editor tree uses, and local-only git state.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
